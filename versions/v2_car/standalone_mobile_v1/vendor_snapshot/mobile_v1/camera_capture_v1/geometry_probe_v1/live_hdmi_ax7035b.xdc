# AX7035B HDMI1 output plus the established J10 OV5640 connection.
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property PACKAGE_PIN Y18 [get_ports clk]
set_property PACKAGE_PIN F20 [get_ports reset_n]
set_property PACKAGE_PIN G16 [get_ports uart_txd]
set_property IOSTANDARD LVCMOS33 [get_ports uart_txd]
set_false_path -to [get_ports uart_txd]
create_clock -name sys_clk -period 20.000 [get_ports clk]

set_property PACKAGE_PIN E1 [get_ports tmds_clk_p]
set_property PACKAGE_PIN D1 [get_ports tmds_clk_n]
set_property PACKAGE_PIN G1 [get_ports {tmds_data_p[0]}]
set_property PACKAGE_PIN F1 [get_ports {tmds_data_n[0]}]
set_property PACKAGE_PIN H2 [get_ports {tmds_data_p[1]}]
set_property PACKAGE_PIN G2 [get_ports {tmds_data_n[1]}]
set_property PACKAGE_PIN K1 [get_ports {tmds_data_p[2]}]
set_property PACKAGE_PIN J1 [get_ports {tmds_data_n[2]}]
set_property IOSTANDARD TMDS_33 [get_ports {tmds_clk_p tmds_clk_n tmds_data_p[*] tmds_data_n[*]}]
set_property PACKAGE_PIN M6 [get_ports hdmi_out_en]

set_property PACKAGE_PIN AB20 [get_ports cam_scl]
set_property PACKAGE_PIN W20 [get_ports cam_sda]
set_property PACKAGE_PIN AB18 [get_ports cam_rst_n]
set_property PULLUP true [get_ports {cam_scl cam_sda}]
set_property PACKAGE_PIN P17 [get_ports {cam_data[0]}]
set_property PACKAGE_PIN R19 [get_ports {cam_data[1]}]
set_property PACKAGE_PIN T18 [get_ports {cam_data[2]}]
set_property PACKAGE_PIN U21 [get_ports {cam_data[3]}]
set_property PACKAGE_PIN V22 [get_ports {cam_data[4]}]
set_property PACKAGE_PIN V20 [get_ports {cam_data[5]}]
set_property PACKAGE_PIN W22 [get_ports {cam_data[6]}]
set_property PACKAGE_PIN Y22 [get_ports {cam_data[7]}]
set_property PACKAGE_PIN W19 [get_ports cam_pclk]
set_property PACKAGE_PIN AA21 [get_ports cam_vsync]
set_property PACKAGE_PIN AB22 [get_ports cam_href]
set_property PACKAGE_PIN F19 [get_ports {led_n[0]}]
set_property PACKAGE_PIN E21 [get_ports {led_n[1]}]
set_property PACKAGE_PIN D20 [get_ports {led_n[2]}]
set_property PACKAGE_PIN C20 [get_ports {led_n[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {clk reset_n hdmi_out_en cam_scl cam_sda cam_rst_n cam_pclk cam_vsync cam_href cam_data[*] led_n[*]}]

# Conservative prototype input timing; sensor output is sampled on PCLK rising.
create_clock -name cam_clk -period 20.833 [get_ports cam_pclk]
set_input_delay -clock cam_clk -clock_fall -max 5.000 [get_ports {cam_data[*] cam_vsync cam_href}]
set_input_delay -clock cam_clk -clock_fall -min 0.000 [get_ports {cam_data[*] cam_vsync cam_href}]
# Include MMCM-derived pixel/serializer clocks in the system-clock group.
set_clock_groups -asynchronous -group [get_clocks cam_clk] -group [get_clocks -include_generated_clocks sys_clk]
set_false_path -from [get_ports {reset_n cam_scl cam_sda cam_rst_n}]
set_false_path -to [get_ports {hdmi_out_en led_n[*] cam_scl cam_sda cam_rst_n}]
